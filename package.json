{
  "name": "household-daemons",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:migrate": "node-pg-migrate up -j sql -m src/db/migrations",
    "auth": "tsx src/scripts/auth.ts",
    "crawl:once": "tsx src/scripts/crawl-once.ts",
    "scheduler": "tsx src/scripts/start-scheduler.ts",
    "daemon:standing-plans": "tsx src/scripts/standing-plans-once.ts",
    "daemon:kitchen-entropy": "tsx src/scripts/kitchen-entropy-once.ts",
    "daemon:dead-mans-switch": "tsx src/scripts/dead-mans-switch-once.ts",
    "add-commitment": "tsx src/scripts/add-commitment.ts",
    "record-purchase": "tsx src/scripts/record-purchase.ts",
    "add-watched-person": "tsx src/scripts/add-watched-person.ts",
    "check-in": "tsx src/scripts/check-in.ts",
    "web": "tsx src/web/server.ts",
