DATABASE_URL=postgres://household_daemons:household_daemons@localhost:5434/household_daemons

# Local port the OAuth callback server listens on during `npm run auth -- <server>`.
# Must match the redirect_uri registered with Swiggy's dynamic client registration.
OAUTH_CALLBACK_PORT=8765

# Bot token from @BotFather (send /newbot in Telegram) -- powers `npm run telegram-bot`,
# the "commitment to X in Y, Friday 8pm" quick-add flow for Standing Plans.
TELEGRAM_BOT_TOKEN=
